# === Lark Base ===
# Cụm quốc tế (larksuite.com) dùng https://open.larksuite.com
# Cụm Trung Quốc (feishu.cn) dùng https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# Lark custom app (Developer Console) — cần bật quyền bitable đọc/ghi và thêm app vào Base
LARK_APP_ID=
LARK_APP_SECRET=

# Base app_token (lấy từ URL Base: /base/<app_token>?table=...)
LARK_APP_TOKEN=GpCXbwtuvaOB0BsavQrlgS5ggXc

# Bảng Danh mục sản phẩm (đã có sẵn)
LARK_TBL_PRODUCTS=tblnJMfzuGgTxzII

# Các bảng dưới đây để TRỐNG -> app tự tạo lần đầu và ghi vào server/tables.local.json.
# Nếu app không có quyền tạo bảng: tự tạo trên Lark rồi điền table id vào đây.
LARK_TBL_PROJECTS=
LARK_TBL_LINES=
LARK_TBL_COVER=

PORT=3000
